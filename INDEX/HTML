<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <meta
    name="description"
    content="Flowly is a simple productivity workspace for modern teams."
  >

  <title>Flowly — Work Beautifully Together</title>

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  <link
    href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap"
    rel="stylesheet"
  >

  <style>

    /* =========================
       RESET
    ========================= */

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: "DM Sans", sans-serif;
      color: #29283b;
      background: #faf9f6;
      line-height: 1.6;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    img {
      max-width: 100%;
      display: block;
    }

    .container {
      width: min(1120px, calc(100% - 40px));
      margin: auto;
    }


    /* =========================
       COLOURS
    ========================= */

    :root {
      --navy: #15152b;
      --dark: #20203a;
      --purple: #7357ff;
      --purple-light: #eeeaff;
      --green: #4fd39b;
      --orange: #ffad66;
      --cream: #faf9f6;
      --white: #ffffff;
      --text: #29283b;
      --muted: #77768a;
      --border: #e8e6ed;
    }


    /* =========================
       NAVBAR
    ========================= */

    .navbar {
      position: sticky;
      top: 0;
      z-index: 1000;

      height: 76px;

      display: flex;
      align-items: center;

      background: rgba(250, 249, 246, 0.95);

      border-bottom: 1px solid var(--border);

      backdrop-filter: blur(12px);
    }

    .nav-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 30px;
    }

    .logo {
      display: flex;
      align-items: center;
      gap: 9px;

      font-family: "Space Grotesk", sans-serif;
      font-size: 22px;
      font-weight: 700;

      color: var(--navy);
    }

    .logo-mark {
      width: 32px;
      height: 32px;

      display: grid;
      place-items: center;

      border-radius: 10px;

      color: white;
      background: var(--purple);

      font-size: 17px;
    }

    nav {
      display: flex;
      align-items: center;
      gap: 32px;

      margin-left: auto;
      margin-right: 25px;
    }

    nav a {
      color: var(--muted);

      font-size: 14px;
      font-weight: 600;

      transition: 0.2s ease;
    }

    nav a:hover {
      color: var(--purple);
    }

    .nav-button {
      padding: 11px 20px;

      color: white;
      background: var(--navy);

      border-radius: 10px;

      font-size: 14px;
      font-weight: 600;

      transition: 0.2s ease;
    }

    .nav-button:hover {
      background: var(--purple);
      transform: translateY(-2px);
    }


    /* =========================
       HERO
    ========================= */

    .hero {
      min-height: 700px;

      display: flex;
      align-items: center;

      padding: 100px 0 120px;

      background:
        radial-gradient(
          circle at 80% 35%,
          rgba(115, 87, 255, 0.12),
          transparent 30%
        ),
        var(--cream);
    }

    .hero-grid {
      display: grid;

      grid-template-columns: 1fr 0.95fr;

      align-items: center;

      gap: 80px;
    }

    .eyebrow {
      display: inline-block;

      margin-bottom: 17px;

      color: var(--purple);

      font-size: 11px;
      font-weight: 700;

      letter-spacing: 2px;
    }

    .hero h1 {
      max-width: 610px;

      margin-bottom: 24px;

      color: var(--navy);

      font-family: "Space Grotesk", sans-serif;

      font-size: clamp(42px, 5vw, 68px);

      line-height: 1.04;

      letter-spacing: -2.5px;
    }

    .hero h1 span {
      color: var(--purple);
    }

    .hero-description {
      max-width: 520px;

      margin-bottom: 32px;

      color: var(--muted);

      font-size: 18px;

      line-height: 1.7;
    }

    .hero-actions {
      display: flex;
      align-items: center;

      flex-wrap: wrap;

      gap: 25px;
    }

    .primary-button {
      display: inline-flex;

      align-items: center;
      justify-content: center;

      gap: 18px;

      padding: 15px 23px;

      color: white;
      background: var(--purple);

      border-radius: 11px;

      font-size: 14px;
      font-weight: 700;

      box-shadow: 0 10px 25px rgba(115, 87, 255, 0.20);

      transition: 0.2s ease;
    }

    .primary-button:hover {
      transform: translateY(-3px);

      box-shadow:
        0 15px 30px rgba(115, 87, 255, 0.28);
    }

    .primary-button span {
      font-size: 19px;
    }

    .text-button {
      color: var(--navy);

      font-size: 14px;
      font-weight: 700;
    }

    .text-button:hover {
      color: var(--purple);
    }

    .hero-note {
      display: flex;
      align-items: center;

      gap: 9px;

      margin-top: 20px;

      color: var(--muted);

      font-size: 12px;
    }

    .check {
      width: 18px;
      height: 18px;

      display: grid;
      place-items: center;

      border-radius: 50%;

      color: #15865b;
      background: #d8f5e9;

      font-size: 11px;
    }


    /* =========================
       PRODUCT MOCKUP
    ========================= */

    .dashboard-wrapper {
      position: relative;

      max-width: 500px;

      margin: auto;
    }

    .dashboard {
      position: relative;
      z-index: 2;

      padding: 26px;

      background: white;

      border: 1px solid var(--border);

      border-radius: 20px;

      box-shadow:
        0 30px 70px rgba(40, 35, 80, 0.13);

      transform: rotate(1.5deg);
    }

    .dashboard-top {
      display: flex;

      align-items: center;
      justify-content: space-between;

      margin-bottom: 25px;
    }

    .small-label {
      color: #aaa9b7;

      font-size: 9px;
      font-weight: 700;

      letter-spacing: 1.5px;
    }

    .dashboard h3 {
      margin-top: 4px;

      color: var(--navy);

      font-family: "Space Grotesk", sans-serif;

      font-size: 20px;
    }

    .avatar {
      width: 38px;
      height: 38px;

      display: grid;
      place-items: center;

      border-radius: 50%;

      color: white;
      background: var(--purple);

      font-size: 11px;
      font-weight: 700;
    }

    .progress-card {
      padding: 19px;

      margin-bottom: 15px;

      border-radius: 13px;

      background: #f6f4ff;
    }

    .progress-info {
      margin-bottom: 12px;
    }

    .progress-info div {
      display: flex;
      justify-content: space-between;

      color: #666477;

      font-size: 12px;
    }

    .progress-info strong {
      color: var(--purple);
    }

    .progress-bar {
      height: 7px;

      overflow: hidden;

      border-radius: 10px;

      background: #ddd9f5;
    }

    .progress-bar span {
      display: block;

      width: 78%;
      height: 100%;

      border-radius: inherit;

      background: var(--purple);
    }

    .task-list {
      display: flex;
      flex-direction: column;

      gap: 5px;
    }

    .task {
      display: flex;
      align-items: center;

      gap: 13px;

      padding: 15px 10px;

      border-bottom: 1px solid #f0eff3;
    }

    .task-check {
      flex: 0 0 auto;

      width: 19px;
      height: 19px;

      border: 2px solid #d6d4dc;

      border-radius: 6px;
    }

    .task.completed .task-check {
      display: grid;
      place-items: center;

      border-color: var(--green);

      color: white;
      background: var(--green);

      font-size: 11px;
    }

    .task strong,
    .task small {
      display: block;
    }

    .task strong {
      color: #39374a;

      font-size: 12px;
    }

    .task small {
      margin-top: 2px;

      color: #aaa9b7;

      font-size: 10px;
    }

    .floating-card {
      position: absolute;

      right: -35px;
      bottom: -25px;

      z-index: 3;

      display: flex;
      align-items: center;

      gap: 12px;

      min-width: 220px;

      padding: 14px 17px;

      border: 1px solid var(--border);

      border-radius: 13px;

      background: white;

      box-shadow:
        0 15px 40px rgba(40, 35, 80, 0.13);
    }

    .notification-icon {
      width: 33px;
      height: 33px;

      display: grid;
      place-items: center;

      border-radius: 9px;

      color: #18855b;
      background: #dff7ec;

      font-size: 13px;
      font-weight: 700;
    }

    .floating-card strong,
    .floating-card small {
      display: block;
    }

    .floating-card strong {
      color: var(--navy);

      font-size: 11px;
    }

    .floating-card small {
      margin-top: 2px;

      color: var(--muted);

      font-size: 9px;
    }


    /* =========================
       GENERAL SECTIONS
    ========================= */

    .section {
      padding: 110px 0;
    }

    .section-heading {
      max-width: 650px;

      margin-bottom: 55px;
    }

    .section-heading h2 {
      margin-bottom: 18px;

      color: var(--navy);

      font-family: "Space Grotesk", sans-serif;

      font-size: clamp(32px, 4vw, 48px);

      line-height: 1.1;

      letter-spacing: -1.5px;
    }

    .section-heading h2 span {
      color: var(--purple);
    }

    .section-heading p {
      max-width: 550px;

      color: var(--muted);

      font-size: 16px;
    }

    .center {
      margin-left: auto;
      margin-right: auto;

      text-align: center;
    }

    .center p {
      margin-left: auto;
      margin-right: auto;
    }


    /* =========================
       FEATURES
    ========================= */

    .features {
      background: white;
    }

    .feature-grid {
      display: grid;

      grid-template-columns: repeat(3, 1fr);

      gap: 20px;
    }

    .feature-card {
      padding: 35px;

      border: 1px solid var(--border);

      border-radius: 17px;

      background: white;

      transition: 0.25s ease;
    }

    .feature-card:hover {
      transform: translateY(-6px);

      box-shadow:
        0 20px 45px rgba(35, 30, 70, 0.08);
    }

    .feature-card.featured {
      border-color: #ded7ff;

      background: #f8f6ff;
    }

    .feature-icon {
      width: 48px;
      height: 48px;

      display: grid;
      place-items: center;

      margin-bottom: 25px;

      border-radius: 13px;

      font-size: 21px;
      font-weight: 700;
    }

    .purple {
      color: var(--purple);

      background: var(--purple-light);
    }

    .green {
      color: #159363;

      background: #ddf8eb;
    }

    .orange {
      color: #e67c23;

      background: #fff0df;
    }

    .feature-card h3 {
      margin-bottom: 11px;

      color: var(--navy);

      font-family: "Space Grotesk", sans-serif;

      font-size: 21px;
    }

    .feature-card p {
      min-height: 75px;

      margin-bottom: 25px;

      color: var(--muted);

      font-size: 14px;
    }

    .feature-card a {
      color: var(--purple);

      font-size: 13px;
      font-weight: 700;
    }


    /* =========================
       ABOUT
    ========================= */

    .about {
      background: var(--cream);
    }

    .about-grid {
      display: grid;

      grid-template-columns: 0.9fr 1fr;

      align-items: center;

      gap: 100px;
    }

    .about-visual {
      position: relative;

      min-height: 430px;

      display: grid;
      place-items: center;

      overflow: hidden;

      border-radius: 25px;

      background: #ece9ff;
    }

    .circle {
      position: absolute;

      border-radius: 50%;

      border: 1px solid rgba(115, 87, 255, 0.18);
    }

    .circle-one {
      width: 390px;
      height: 390px;
    }

    .circle-two {
      width: 280px;
      height: 280px;
    }

    .quote-card {
      position: relative;
      z-index: 2;

      width: min(310px, 75%);

      padding: 30px;

      border-radius: 18px;

      background: white;

      box-shadow:
        0 20px 50px rgba(55, 45, 110, 0.12);
    }

    .quote-mark {
      color: var(--purple);

      font-family: Georgia, serif;

      font-size: 48px;

      line-height: 0.7;
    }

    .quote-card p {
      margin: 15px 0 20px;

      color: var(--navy);

      font-family: "Space Grotesk", sans-serif;

      font-size: 19px;
      font-weight: 600;

      line-height: 1.45;
    }

    .quote-card span {
      color: var(--muted);

      font-size: 11px;
    }

    .about-content h2 {
      max-width: 500px;

      margin-bottom: 22px;

      color: var(--navy);

      font-family: "Space Grotesk", sans-serif;

      font-size: clamp(34px, 4vw, 49px);

      line-height: 1.08;

      letter-spacing: -1.5px;
    }

    .about-content h2 span {
      color: var(--purple);
    }

    .about-content > p {
      max-width: 540px;

      margin-bottom: 15px;

      color: var(--muted);

      font-size: 15px;
    }

    .stats {
      display: flex;

      flex-wrap: wrap;

      gap: 45px;

      margin-top: 35px;

      padding-top: 28px;

      border-top: 1px solid #e3e1e8;
    }

    .stats strong,
    .stats span {
      display: block;
    }

    .stats strong {
      color: var(--navy);

      font-family: "Space Grotesk", sans-serif;

      font-size: 28px;
    }

    .stats span {
      color: var(--muted);

      font-size: 11px;
    }


    /* =========================
       TESTIMONIALS
    ========================= */

    .reviews {
      background: white;
    }

    .review-grid {
      display: grid;

      grid-template-columns: repeat(3, 1fr);

      gap: 20px;
    }

    .review-card {
      padding: 30px;

      border: 1px solid var(--border);

      border-radius: 17px;

      background: white;
    }

    .stars {
      margin-bottom: 18px;

      color: #ffad4f;

      letter-spacing: 2px;
    }

    .review-card > p {
      min-height: 120px;

      color: #5e5c6c;

      font-size: 14px;

      line-height: 1.7;
    }

    .review-author {
      display: flex;
      align-items: center;

      gap: 12px;

      padding-top: 20px;

      border-top: 1px solid #eeeef1;
    }

    .author-avatar {
      width: 38px;
      height: 38px;

      display: grid;
      place-items: center;

      border-radius: 50%;

      font-size: 10px;
      font-weight: 700;
    }

    .author-purple {
      color: #6a52df;
      background: #e9e5ff;
    }

    .author-green {
      color: #18855b;
      background: #dff7ec;
    }

    .author-orange {
      color: #d97827;
      background: #ffecd7;
    }

    .review-author strong,
    .review-author span {
      display: block;
    }

    .review-author strong {
      color: var(--navy);

      font-size: 12px;
    }

    .review-author span {
      color: var(--muted);

      font-size: 10px;
    }


    /* =========================
       CTA
    ========================= */

    .cta {
      padding: 85px 0;

      color: white;

      background: var(--navy);
    }

    .cta-inner {
      display: flex;

      align-items: center;
      justify-content: space-between;

      gap: 40px;
    }

    .cta .eyebrow {
      color: var(--green);
    }

    .cta h2 {
      margin-bottom: 10px;

      font-family: "Space Grotesk", sans-serif;

      font-size: clamp(32px, 4vw, 48px);

      line-height: 1.1;
    }

    .cta p {
      color: #aaa9bc;

      font-size: 15px;
    }

    .cta .primary-button {
      flex: 0 0 auto;

      color: var(--navy);

      background: white;

      box-shadow: none;
    }

    .cta .primary-button:hover {
      color: white;

      background: var(--purple);
    }


    /* =========================
       FOOTER
    ========================= */

    footer {
      color: #a4a3b4;

      background: #111122;
    }

    .footer-top {
      display: flex;

      justify-content: space-between;

      gap: 40px;

      padding: 55px 0 45px;
    }

    .footer-logo {
      color: white;
    }

    .footer-description {
      margin-top: 12px;

      font-size: 12px;
    }

    .footer-links {
      display: flex;

      align-items: center;

      flex-wrap: wrap;

      gap: 25px;
    }

    .footer-links a {
      font-size: 12px;

      transition: 0.2s ease;
    }

    .footer-links a:hover {
      color: white;
    }

    .footer-bottom {
      display: flex;

      justify-content: space-between;

      padding: 20px 0;

      border-top: 1px solid #29283a;

      font-size: 10px;
    }


    /* =========================
       TABLET
    ========================= */

    @media (max-width: 900px) {

      .hero-grid {
        grid-template-columns: 1fr;

        gap: 70px;
      }

      .hero-content {
        text-align: center;
      }

      .hero-description {
        margin-left: auto;
        margin-right: auto;
      }

      .hero-actions {
        justify-content: center;
      }

      .hero-note {
        justify-content: center;
      }

      .dashboard-wrapper {
        width: min(100%, 520px);
      }

      .feature-grid,
      .review-grid {
        grid-template-columns: 1fr;
      }

      .about-grid {
        grid-template-columns: 1fr;

        gap: 60px;
      }

      .about-content {
        text-align: center;
      }

      .about-content h2,
      .about-content > p {
        margin-left: auto;
        margin-right: auto;
      }

      .stats {
        justify-content: center;
      }

      .feature-card p,
      .review-card > p {
        min-height: auto;
      }
    }


    /* =========================
       MOBILE
    ========================= */

    @media (max-width: 650px) {

      .container {
        width: min(100% - 28px, 1120px);
      }

      .navbar {
        height: 68px;
      }

      .nav-inner {
        gap: 10px;
      }

      nav {
        gap: 15px;

        margin: 0;
      }

      nav a {
        font-size: 12px;
      }

      .nav-button {
        display: none;
      }

      .logo {
        font-size: 19px;
      }

      .logo-mark {
        width: 29px;
        height: 29px;
      }

      .hero {
        min-height: auto;

        padding: 75px 0 100px;
      }

      .hero h1 {
        font-size: 43px;

        letter-spacing: -1.8px;
      }

      .hero-description {
        font-size: 16px;
      }

      .dashboard {
        padding: 19px;
      }

      .floating-card {
        right: -5px;
        bottom: -30px;

        min-width: 190px;
      }

      .section {
        padding: 80px 0;
      }

      .section-heading {
        margin-bottom: 38px;
      }

      .section-heading h2 {
        font-size: 35px;
      }

      .feature-card {
        padding: 28px;
      }

      .about-visual {
        min-height: 350px;
      }

      .circle-one {
        width: 310px;
        height: 310px;
      }

      .circle-two {
        width: 220px;
        height: 220px;
      }

      .about-content h2 {
        font-size: 36px;
      }

      .stats {
        gap: 25px;
      }

      .cta {
        padding: 70px 0;
      }

      .cta-inner {
        flex-direction: column;

        align-items: flex-start;
      }

      .footer-top,
      .footer-bottom {
        flex-direction: column;

        gap: 25px;
      }

      .footer-links {
        gap: 18px;
      }
    }


    /* =========================
       SMALL PHONES
    ========================= */

    @media (max-width: 430px) {

      nav a:nth-child(3) {
        display: none;
      }

      .hero h1 {
        font-size: 38px;
      }

      .hero-actions {
        flex-direction: column;

        gap: 18px;
      }

      .primary-button {
        width: 100%;
      }

      .dashboard-wrapper {
        width: calc(100% - 10px);
      }

      .floating-card {
        position: relative;

        right: auto;
        bottom: auto;

        width: 90%;

        margin: -10px auto 0;
      }
    }

  </style>
</head>

<body>

  <!-- =========================
       NAVIGATION
  ========================= -->

  <header class="navbar">

    <div class="container nav-inner">

      <a href="#home" class="logo">
        <span class="logo-mark">F</span>
        Flowly
      </a>

      <nav aria-label="Main navigation">

        <a href="#features">Features</a>

        <a href="#about">About</a>

        <a href="#reviews">Reviews</a>

      </nav>

      <a href="#get-started" class="nav-button">
        Get Started
      </a>

    </div>

  </header>


  <main>

    <!-- =========================
         HERO SECTION
    ========================= -->

    <section class="hero" id="home">

      <div class="container hero-grid">

        <div class="hero-content">

          <span class="eyebrow">
            THE SIMPLE WAY TO WORK
          </span>

          <h1>
            Turn busy work into
            <span>beautiful progress.</span>
          </h1>

          <p class="hero-description">
            Flowly brings your tasks, projects, and team
            conversations together in one calm and focused
            workspace.
          </p>

          <div class="hero-actions">

            <a href="#get-started" class="primary-button">
              Start for free
              <span>→</span>
            </a>

            <a href="#features" class="text-button">
              Explore features
            </a>

          </div>

          <div class="hero-note">

            <span class="check">✓</span>

            No credit card required

          </div>

        </div>


        <!-- Product Dashboard -->

        <div class="dashboard-wrapper">

          <div class="dashboard">

